# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Anthropic (the AI that looks at the photos) ---
# Create a key at https://console.anthropic.com -> API keys.
LOST_CAUSE_ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: which Claude model looks at the photos (default claude-sonnet-5-5)
LOST_CAUSE_MODEL=claude-sonnet-5-5
# Optional, development only: stop after this many vision calls (default 30)
LOST_CAUSE_AI_CALL_LIMIT=30

# --- PayFast (payments in ZAR) ---
# Your merchant ID, key and passphrase are on your PayFast dashboard after you log in:
# sandbox.payfast.co.za for testing, www.payfast.co.za when live. Set the passphrase
# yourself in the dashboard's developer settings.
PAYFAST_MERCHANT_ID=10000000
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
# sandbox: https://sandbox.payfast.co.za/eng/process   live: https://www.payfast.co.za/eng/process
PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process
# "sandbox" or "live"
PAYFAST_MODE=sandbox

# --- The app itself ---
# Signs the session cookie. Make one with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-hex-characters
# Public address PayFast sends people back to (and posts its ITN to)
APP_URL=http://localhost:3000
