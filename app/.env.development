# Development only (next dev). No secrets here: this points the app at the LOCAL Firebase
# emulators. "demo-" project IDs can never reach a real Firebase project.
# Real keys (Anthropic, PayFast sandbox) live in .env.local, which is never committed.
FIREBASE_CONFIG='{"projectId":"demo-lost-cause","storageBucket":"demo-lost-cause.appspot.com"}'
FIREBASE_WEBAPP_CONFIG='{"apiKey":"demo-api-key","authDomain":"demo-lost-cause.firebaseapp.com","projectId":"demo-lost-cause"}'
GCLOUD_PROJECT=demo-lost-cause
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
